{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/events",
      "destination": "/api/index?__route=/api/events"
    },
    {
      "source": "/api/events/:path*",
      "destination": "/api/index?__route=/api/events/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index?__route=/health"
    }
  ]
}
