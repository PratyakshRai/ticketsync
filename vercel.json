{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__route=/api/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "/api/index?__route=/socket.io/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index?__route=/health"
    }
  ]
}
